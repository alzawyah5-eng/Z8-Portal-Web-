{
  "name": "AccountEntry",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "The client's Z8 login"
    },
    "client_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deposit",
        "card_opening",
        "card_topup",
        "refund",
        "adjustment"
      ],
      "description": "deposit: money received from the client; card_opening / card_topup: moved onto a card; refund: returned to the account; adjustment: correction by an administrator"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "rejected"
      ],
      "default": "completed",
      "description": "pending: a deposit the client reported, not yet confirmed"
    },
    "amount": {
      "type": "number",
      "description": "USD, signed: positive adds to the balance, negative takes from it"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "cash",
        "other",
        ""
      ],
      "description": "How a deposit was paid"
    },
    "reference": {
      "type": "string",
      "description": "Transfer reference or receipt number"
    },
    "note": {
      "type": "string",
      "description": "Shown to the client"
    },
    "admin_note": {
      "type": "string",
      "description": "Internal; never shown to the client"
    },
    "reported_by": {
      "type": "string",
      "enum": [
        "client",
        "admin"
      ],
      "default": "admin"
    },
    "reported_amount": {
      "type": "number",
      "description": "Amount the client said they sent, when it differs from what was confirmed"
    },
    "recorded_by": {
      "type": "string",
      "description": "Administrator who recorded or reviewed it"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "card_id": {
      "type": "string"
    },
    "card_request_id": {
      "type": "string"
    },
    "proof_file_uri": { "type": "string", "description": "Private file: photo or PDF proving the payment. Opened only through a signed link." },
    "proof_type": { "type": "string" },
    "proof_name": { "type": "string" }
  },
  "required": [
    "owner_email",
    "kind",
    "status",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}