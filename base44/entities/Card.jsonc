{
  "name": "Card",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["emerald", "plum", "crimson", ""],
      "description": "Card tier (brand colour): emerald, plum or crimson"
    },
    "purpose": {
      "type": "string",
      "enum": ["online_shopping", "advertising", "subscriptions", "travel", "business_expenses", "other", ""],
      "description": "What the card is for, chosen by the client when requesting it"
    },
    "purpose_detail": {
      "type": "string",
      "description": "The client's own words when the purpose is other"
    },
    "masked_number": {
      "type": "string"
    },
    "last4": {
      "type": "string"
    },
    "expiry": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ],
      "default": "USD"
    },
    "scheme": {
      "type": "string",
      "enum": [
        "MasterCard",
        "Discover"
      ],
      "default": "MasterCard"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "share",
        "recharge"
      ],
      "default": "share"
    },
    "form_factor": {
      "type": "string",
      "enum": [
        "virtual_card"
      ],
      "default": "virtual_card"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "pending",
        "cancelled"
      ],
      "default": "pending"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "monthly_spend": {
      "type": "number",
      "default": 0
    },
    "max_on_daily": {
      "type": "number"
    },
    "max_on_monthly": {
      "type": "number"
    },
    "max_on_percent": {
      "type": "number"
    },
    "transaction_limit_type": {
      "type": "string",
      "enum": [
        "limited",
        "unlimited"
      ],
      "default": "unlimited"
    },
    "cardholder_name": {
      "type": "string"
    },
    "cardholder_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photon_card_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photon_cardholder_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "request_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bin": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "owner_email": {
      "type": "string",
      "description": "Account email assigned access by an administrator",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "funded_at": {
      "type": "string",
      "format": "date-time",
      "description": "First time the card was funded; card details unlock for the owner from then on"
    },
    "auto_issued": {
      "type": "boolean",
      "default": false,
      "description": "Requested by the client (or issued on approval earlier); details stay locked for the owner until funded"
    },
    "pending_topup_amount": {
      "type": "number",
      "description": "Amount of the open top-up quote, taken from the client's account balance when confirmed"
    },
    "pending_topup_request_id": {
      "type": "string",
      "description": "requestId of the latest top-up quote awaiting confirmation",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "nickname",
    "currency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.owner_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}