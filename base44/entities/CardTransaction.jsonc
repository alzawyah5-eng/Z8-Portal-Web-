{
  "name": "CardTransaction",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "spend",
        "refund",
        "fee",
        "event"
      ],
      "default": "spend"
    },
    "event": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "card_nickname": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "declined"
      ],
      "default": "completed"
    },
    "category": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "photon_txn_id": {
      "type": "string",
      "description": "Provider transaction identifier, used to ignore duplicate notifications",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "owner_email": {
      "type": "string",
      "description": "Account email assigned access by an administrator",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "kind",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.owner_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}