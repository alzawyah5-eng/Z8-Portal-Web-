{
  "name": "CardholderApplication",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Z8 account that submitted the application"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "submitted: waiting for an administrator; approved: sent to PhotonPay; rejected: declined by an administrator"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "mobile_prefix": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "address_line": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "cert_type": {
      "type": "string",
      "enum": [
        "id_card",
        "passport",
        "resident_permit"
      ]
    },
    "cert_id": {
      "type": "string",
      "description": "Full ID number until sent to PhotonPay, then masked to the last four characters"
    },
    "cert_country": {
      "type": "string"
    },
    "front_file_uri": {
      "type": "string",
      "description": "Private Base44 file holding the ID front / passport photo page"
    },
    "back_file_uri": {
      "type": "string",
      "description": "Private Base44 file holding the ID back"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string",
      "description": "Administrator's note to the client (shown on rejection)"
    },
    "last_error": {
      "type": "string",
      "description": "Why the last attempt to send it to PhotonPay failed"
    },
    "photon_cardholder_id": {
      "type": "string"
    },
    "cardholder_record_id": {
      "type": "string"
    },
    "device_ip": {
      "type": "string",
      "description": "Public IP of the client's device when submitting (used when their card is issued automatically)"
    },
    "device_country": {
      "type": "string",
      "description": "Country the client said they were in when submitting"
    }
  },
  "required": [
    "owner_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}