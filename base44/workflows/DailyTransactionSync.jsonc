{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_transaction_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_transactions": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "photonpayTransactionSync",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync PhotonPay transactions",
            "description": "Back-fill the previous day's card transactions"
          }
        }
      }
    ]
  },
  "name": "Daily Transaction Sync",
  "description": "Once a day, pulls the last 24+ hours of card transactions from PhotonPay and records any the webhooks missed. Also removes request logs older than 90 days.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "17 2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}