{
  "name": "Declined Transaction Alerts",
  "description": "Emails the programme administrators whenever a declined card transaction is recorded.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "CardTransaction",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"declined\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "declined_transaction_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_decline_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendProgrammeAlert",
            "args": {
              "kind": "declined",
              "record_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Alert administrators",
            "description": "Declined transaction"
          }
        }
      }
    ]
  }
}